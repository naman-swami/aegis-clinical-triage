{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClinicalVitalsRecord",
  "type": "object",
  "properties": {
    "heart_rate": {
      "type": "number",
      "minimum": 20,
      "maximum": 250
    },
    "respiratory_rate": {
      "type": "number",
      "minimum": 4,
      "maximum": 60
    },
    "systolic_bp": {
      "type": "number",
      "minimum": 40,
      "maximum": 260
    },
    "diastolic_bp": {
      "type": "number",
      "minimum": 20,
      "maximum": 160
    },
    "spo2": {
      "type": "number",
      "minimum": 50,
      "maximum": 100
    },
    "temperature_c": {
      "type": "number",
      "minimum": 30.0,
      "maximum": 45.0
    },
    "gcs": {
      "type": "integer",
      "minimum": 3,
      "maximum": 15
    }
  },
  "required": [
    "heart_rate",
    "respiratory_rate",
    "systolic_bp"
  ]
}